# Copy to .env (git-ignored) and adjust. Docker Compose reads .env from this
# directory automatically.

# Host port the dashboard is published on. It's always bound to 127.0.0.1.
DASHBOARD_PORT=8080

# How often the dashboard polls Docker, as a Go duration (e.g. 5s, 30s, 1m).
# Minimum 1s.
POLL_INTERVAL=5s
