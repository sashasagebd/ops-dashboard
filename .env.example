# Copy to .env (git-ignored) and adjust. Docker Compose reads .env from this
# directory automatically.

# Host port the dashboard is published on. It's always bound to 127.0.0.1.
DASHBOARD_PORT=8080

# How often the dashboard polls Docker, as a Go duration (e.g. 5s, 30s, 1m).
# Minimum 1s.
POLL_INTERVAL=5s

# Password for the platform's Postgres. Required: compose refuses to start
# without it. Generate one with `openssl rand -hex 32`; hex needs no escaping
# in the platform's connection URL. Only read when the database volume is
# first created, so changing it later also needs ALTER USER in Postgres.
POSTGRES_PASSWORD=

# Key that encrypts app env vars in the platform's database. Required.
# Generate with `openssl rand -hex 32`. Keep a copy somewhere safe (e.g. a
# password manager): unlike POSTGRES_PASSWORD it can't be reset, and without
# it every stored env var value is unrecoverable. Never commit it.
PLATFORM_SECRET_KEY=

# Apps the platform deploys are served at <name>.<APPS_DOMAIN>. Required.
# Until there's a real domain, use sslip.io with the server's Tailscale IP,
# dots replaced by dashes: e.g. for 100.101.102.103,
#   APPS_DOMAIN=100-101-102-103.sslip.io
# (`tailscale ip -4` prints the IP.) Apps are then reachable from tailnet
# devices only.
APPS_DOMAIN=

# The IP Caddy accepts app traffic on (port 80): the server's Tailscale IP,
# the same one as in APPS_DOMAIN. Required. Don't use 0.0.0.0: Docker
# bypasses UFW, so that would serve every app to the whole LAN.
APPS_LISTEN_IP=

# Optional GitHub token for downloading app code. Without one, GitHub allows
# 60 requests an hour from this server's IP, and only public repos work. A
# fine-grained token with read-only "Contents" access to the repos you deploy
# is enough. Never commit it.
GITHUB_TOKEN=

# Push-to-deploy: the secret shared with the GitHub webhook, which signs every
# delivery with it. Optional: unset, the webhook listener doesn't run and apps
# only deploy from the dashboard. At least 32 characters; generate with
# `openssl rand -hex 32` and paste the same value into the webhook's "Secret"
# field on GitHub. Never commit it. See the README's "Push-to-deploy".
GITHUB_WEBHOOK_SECRET=

# Public hostnames, through Cloudflare Tunnel (see the README's "Public
# hostnames"). Optional: unset, every app stays tailnet-only and the webhook
# has no public URL. The domain on Cloudflare: apps you make public are served
# at <public name>.<PUBLIC_DOMAIN>, the GitHub webhook at
# hooks.<PUBLIC_DOMAIN>. Must differ from APPS_DOMAIN.
PUBLIC_DOMAIN=
# The tunnel's token, from Cloudflare's dashboard (Networks > Tunnels). Never
# commit it.
CLOUDFLARE_TUNNEL_TOKEN=
# Turns on the cloudflared service; leave it out to run without the tunnel.
# COMPOSE_PROFILES=tunnel

# Where backups of app databases are written: an absolute path to a directory
# that exists (`mkdir -p ~/backups` first). Required: compose refuses to start
# without it. Each app's dumps go in a folder of its own, the newest 7 kept.
BACKUP_DIR=/home/sasha/backups

# Who the backups are written as, so the files are yours: your user's uid and
# gid (`id -u`, `id -g`). Optional; both default to 1000, the first user on
# Ubuntu.
BACKUP_UID=1000
BACKUP_GID=1000
